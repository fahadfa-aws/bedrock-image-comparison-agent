# ============================================
# AWS Credentials
# ============================================
# IAM user credentials with Bedrock access
# Required permissions: bedrock:InvokeModel, bedrock:Retrieve
# See iam-policy.json for the complete IAM policy
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# Primary AWS region for Claude Sonnet 4.5 and Nova Canvas
# Must be us-east-1 for Nova Canvas model access
AWS_REGION=us-east-1

# AWS Knowledge Base ID for model documentation retrieval
# Format: XXXXXXXXXX (10 alphanumeric characters)
# This Knowledge Base should contain Bedrock model documentation
# Set to 'disabled' to use fallback mode without Knowledge Base
AWS_KNOWLEDGE_BASE_ID=your-knowledge-base-id-here

# ============================================
# Application Configuration
# ============================================
# Environment: development, production, or test
NODE_ENV=development

# Port for the Express API server
# Frontend will proxy API requests to this port in development
PORT=3000

# Logging level: error, warn, info, debug
# Use 'info' for production, 'debug' for development
LOG_LEVEL=info

# ============================================
# Cache Configuration
# ============================================
# Time-to-live for model documentation cache in milliseconds
# Default: 86400000 (24 hours)
# Model documentation is cached to reduce Knowledge Base queries
DOCUMENTATION_CACHE_TTL=86400000

# ============================================
# Generation Limits and Timeouts
# ============================================
# Maximum number of models that can generate images concurrently
# Range: 2-6 models
# Default: 6 (all available models)
MAX_CONCURRENT_GENERATIONS=6

# Timeout for individual model image generation in milliseconds
# Default: 60000 (60 seconds)
# Increase if experiencing timeout errors with complex prompts
GENERATION_TIMEOUT=60000

# Timeout for prompt optimization with Claude Sonnet 4.5 in milliseconds
# Default: 10000 (10 seconds)
OPTIMIZATION_TIMEOUT=10000

# ============================================
# Regional Configuration (Advanced)
# ============================================
# These regions are required for specific model access
# Do not change unless AWS Bedrock model availability changes

# Region for Amazon Nova Canvas model
# Must be us-east-1
NOVA_REGION=us-east-1

# Region for Stability AI models (SDXL, Core, Ultra)
# Must be us-west-2
STABILITY_REGION=us-west-2

# Region for Claude Sonnet 4.5 (prompt optimization)
# Must be us-east-1
CLAUDE_REGION=us-east-1

# ============================================
# Rate Limiting (Optional)
# ============================================
# Rate limit window in milliseconds
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per IP within the rate limit window
# Default: 100
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Image Storage Configuration
# ============================================
# Storage type: 'local' or 's3'
# Default: local
IMAGE_STORAGE_TYPE=local

# Local storage configuration (when IMAGE_STORAGE_TYPE=local)
# Directory path for storing generated images and metadata
# Default: ./images
IMAGE_STORAGE_PATH=./images

# Maximum storage size for images in bytes
# Default: 10737418240 (10 GB)
MAX_STORAGE_SIZE=10737418240

# S3 storage configuration (when IMAGE_STORAGE_TYPE=s3)
# S3 bucket names (replace {account-id} with your AWS account ID)
# Get your account ID by running: aws sts get-caller-identity --query Account --output text
S3_BUCKET_US_EAST_1=bedrock-image-comparison-us-east-1-{account-id}-dev
S3_BUCKET_US_WEST_2=bedrock-image-comparison-us-west-2-{account-id}-dev

# Signed URL expiration time in seconds
# Default: 3600 (1 hour)
S3_SIGNED_URL_EXPIRATION=3600

# Optional: Custom S3 endpoint for LocalStack testing
# S3_ENDPOINT=http://localhost:4566
